FROM ubuntu:24.04

RUN apt-get update && apt-get install -y --no-install-recommends \
    build-essential \
    liburing-dev \
    gdb \
    strace \
    netcat-openbsd \
    autoconf \
    automake \
    libtool \
    pkg-config \
    git \
    perl \
    libev-dev \
    ca-certificates \
    wget \
    gnupg \
    lsb-release \
    software-properties-common \
    && rm -rf /var/lib/apt/lists/*

RUN wget https://apt.llvm.org/llvm.sh -O /tmp/llvm.sh \
    && chmod +x /tmp/llvm.sh \
    && /tmp/llvm.sh 19 \
    && rm /tmp/llvm.sh \
    && apt-get install -y --no-install-recommends libc++-19-dev libc++abi-19-dev

ENV QUIC_DEPS=/opt/quic-deps
ENV PKG_CONFIG_PATH=${QUIC_DEPS}/openssl/lib/pkgconfig:${QUIC_DEPS}/nghttp3/lib/pkgconfig:${QUIC_DEPS}/ngtcp2/lib/pkgconfig
ENV LD_LIBRARY_PATH=${QUIC_DEPS}/openssl/lib:${QUIC_DEPS}/nghttp3/lib:${QUIC_DEPS}/ngtcp2/lib
ENV PATH=${QUIC_DEPS}/ngtcp2/bin:${PATH}

RUN git clone --depth 1 --branch openssl-3.5.0 https://github.com/openssl/openssl /tmp/openssl \
    && cd /tmp/openssl \
    && ./config --prefix=${QUIC_DEPS}/openssl --libdir=lib \
    && make -j$(nproc) \
    && make install_sw \
    && mkdir -p ${QUIC_DEPS}/openssl/ssl \
    && cp apps/openssl.cnf ${QUIC_DEPS}/openssl/ssl/openssl.cnf \
    && rm -rf /tmp/openssl

RUN git clone --depth 1 --recursive https://github.com/ngtcp2/nghttp3 /tmp/nghttp3 \
    && cd /tmp/nghttp3 \
    && autoreconf -i \
    && ./configure --prefix=${QUIC_DEPS}/nghttp3 --enable-lib-only \
    && make -j$(nproc) \
    && make install \
    && rm -rf /tmp/nghttp3

RUN git clone --depth 1 --recursive https://github.com/ngtcp2/ngtcp2 /tmp/ngtcp2 \
    && cd /tmp/ngtcp2 \
    && autoreconf -i \
    && CC=clang-19 CXX=clang++-19 CXXFLAGS="-stdlib=libc++" ./configure PKG_CONFIG_PATH=${PKG_CONFIG_PATH} \
        LDFLAGS="-stdlib=libc++ -Wl,-rpath,${QUIC_DEPS}/openssl/lib" \
        --prefix=${QUIC_DEPS}/ngtcp2 \
        --with-openssl \
    && make -j$(nproc) \
    && make install \
    && mkdir -p ${QUIC_DEPS}/ngtcp2/bin \
    && cp examples/osslclient examples/osslserver ${QUIC_DEPS}/ngtcp2/bin/ \
    && rm -rf /tmp/ngtcp2

WORKDIR /work

CMD ["/bin/bash"]